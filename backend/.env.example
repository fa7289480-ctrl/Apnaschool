# ApnaSchool backend — copy to backend/.env and fill real values.
# NEVER commit backend/.env or real secrets.
# Built by Ranjha Farhan

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Production: NODE_ENV=production

# ── Database (required) ───────────────────────────────────────────────────
# Percent-encode special characters in USER/PASSWORD.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/apnaschool?schema=public
# Optional (Prisma migrate shadow DB, local only):
# SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/apnaschool_shadow?schema=public

# ── Session (required, ≥32 cryptographically random characters) ───────────
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS

# ── CORS (exact origins, comma-separated, no trailing slash) ──────────────
# Local example:
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost,http://10.0.2.2:3001
# Production example (replace with your real HTTPS frontend origin(s)):
# CORS_ORIGIN=https://app.example.com

# ── Public app URL (email verification + password-reset links) ────────────
APP_BASE_URL=http://localhost:3000
# Production: APP_BASE_URL=https://app.example.com

# ── Cookies ───────────────────────────────────────────────────────────────
# Forced true when NODE_ENV=production regardless of this value.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# SESSION_COOKIE_NAME=apnaschool_sid
# SESSION_TTL_SECONDS=604800
# SESSION_REMEMBER_TTL_SECONDS=2592000

# ── SMTP (required when NODE_ENV=production) ──────────────────────────────
# Used for email verification and password-reset delivery.
# If SMTP_HOST is missing in production, the process refuses to start.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_FROM=ApnaSchool <no-reply@example.com>

# ── Super Admin seed (optional; run once on a controlled DB only) ──────────
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
# If SEED_SUPER_ADMIN_PASSWORD is omitted, seed generates a one-time password
# and prints it once to the console. Rotate immediately after first login.
# SEED_SUPER_ADMIN_PASSWORD=

# ── Optional AI (Ollama) ──────────────────────────────────────────────────
# When absent, textbook/paper AI endpoints return HTTP 503 (no fake results).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ── Rate limits (optional) ────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

// ApnaSchool — Prisma Schema
// PostgreSQL multi-tenant SaaS for school management
//
// Multi-tenant strategy: every tenant-scoped model has a schoolId foreign key.
// The application-layer middleware (schoolIsolation) injects req.schoolId from
// the authenticated session and every query must scope by it. Super Admin
// (schoolId = null) bypasses isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum SchoolStatus {
  PENDING      // Registered, awaiting approval
  TRIAL        // Approved, 15-day trial active
  ACTIVE       // Trial complete, payment verified
  EXPIRED      // Trial ended, read-only access
  REJECTED     // Super Admin rejected the registration
  SUSPENDED    // Super Admin deactivated manually
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentStatus {
  PENDING      // Principal uploaded receipt, awaiting verification
  VERIFIED     // Super Admin verified the payment
  REJECTED     // Super Admin rejected the payment
}

enum ExamType {
  CLASS_TEST
  MONTHLY
  MIDTERM
  FINAL
}

enum ExamStatus {
  DRAFT
  MARKS_SUBMITTED
  RETURNED
  APPROVED
  PUBLISHED
}

enum ExamSubjectStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ────────────────────────────────────────────────────────────────────────────
// Core Models
// ────────────────────────────────────────────────────────────────────────────

model School {
  id               String       @id @default(cuid())
  /// Human-readable sequential school code, e.g. SCH-0001 (unique platform-wide)
  publicCode       String?      @unique @db.VarChar(32)
  name             String
  address          String?
  city             String?
  phone            String?
  email            String?      @unique
  website          String?

  status           SchoolStatus @default(PENDING)

  // Trial management
  trialStartsAt    DateTime?
  trialEndsAt      DateTime?

  // Subscription
  plan             String?      // e.g. "basic", "premium" — pricing TBD
  planExpiresAt    DateTime?

  // Approval
  approvedBy       String?      // Super Admin userId (FK to User)
  approvedByUser   User?        @relation("SchoolApproval", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  rejectionReason  String?

  // Deactivation
  deactivatedAt    DateTime?
  deactivationReason String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  users            User[]
  classes          Class[]
  teachers         Teacher[]
  students         Student[]
  parents          Parent[]
  payments         Payment[]
  auditLogs        AuditLog[]
  attendance       Attendance[]
  feeCategories    FeeCategory[]
  feeStructures    FeeStructure[]
  feeInvoices      FeeInvoice[]
  feePayments      FeePayment[]
  feeAdjustments   FeeAdjustment[]
  homeworks        Homework[]
  homeworkSubmissions HomeworkSubmission[]
  homeworkSubmissionHistory HomeworkSubmissionHistory[]
  academicYears AcademicYear[]
  examTerms ExamTerm[]
  exams Exam[]
  examSubjects ExamSubject[]
  examMarks ExamMark[]
  gradeBands ExamGradeBand[]
  examMarkHistory ExamMarkHistory[]
  subjects Subject[]
  classSubjectAssignments ClassSubjectAssignment[]
  timetablePeriods TimetablePeriod[]
  announcements Announcement[]
  announcementReads AnnouncementRead[]
  notifications Notification[]
  questionPapers QuestionPaper[]
  textbooks      Textbook[]
  textbookChapters TextbookChapter[]
  questionBankItems QuestionBankItem[]

  @@index([status])
  @@index([city])
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  /// Sequential public login id: PRI-0001, TCH-0001, STU-0001, PAR-0001, ADM-0001
  publicCode       String?      @unique @db.VarChar(32)
  /// Optional username (unique when set); login accepts email, publicCode or username
  username         String?      @unique @db.VarChar(64)

  firstName        String
  lastName         String

  role             Role         @default(SCHOOL_ADMIN)

  // Multi-tenant: null for SUPER_ADMIN, required for all other roles
  schoolId         String?
  school           School?      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Account state
  isActive         Boolean      @default(true)
  mustChangePassword Boolean   @default(false)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil      DateTime?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  sessions         Session[]
  tokens           Token[]
  auditLogs        AuditLog[]
  approvedSchools  School[]     @relation("SchoolApproval")
  verifiedPayments Payment[]
  attendanceMarks  Attendance[] @relation("AttendanceMarker")
  feePaymentsRecorded FeePayment[] @relation("FeePaymentRecorder")
  feeAdjustmentsCreated FeeAdjustment[] @relation("FeeAdjustmentCreator")
  homeworksCreated Homework[] @relation("HomeworkAuthor")
  homeworkReviews HomeworkSubmission[] @relation("HomeworkReviewer")
  teachers         Teacher[]
  students         Student[]
  parents          Parent[]
  announcementsCreated Announcement[] @relation("AnnouncementAuthor")
  announcementReads AnnouncementRead[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  feeInvoicesCreated FeeInvoice[] @relation("FeeInvoiceCreator")
  feeInvoicesApproved FeeInvoice[] @relation("FeeInvoiceApprover")
  feeInvoiceApprovalEvents FeeInvoiceApprovalEvent[] @relation("FeeInvoiceApprovalActor")
  questionPapersCreated QuestionPaper[] @relation("QuestionPaperAuthor")
  paperVersionsSubmitted QuestionPaperVersion[] @relation("PaperVersionSubmitter")
  questionPaperReviews QuestionPaperReview[] @relation("PaperReviewer")
  textbooksUploaded Textbook[] @relation("TextbookUploader")
  questionBankItemsCreated QuestionBankItem[] @relation("QuestionBankAuthor")

  @@index([schoolId])
  @@index([role])
  @@index([email])
  @@index([publicCode])
  @@index([username])
}

model Session {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session token stored in httpOnly cookie (not the DB id — a separate random token)
  token            String       @unique
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?

  createdAt        DateTime     @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Tokens — email verification & password reset
// ────────────────────────────────────────────────────────────────────────────
// Only the SHA-256 *hash* of the token is stored; the plaintext travels in the
// email link / is never persisted. Tokens are single-use (consumedAt) and
// short-lived (expiresAt).

model Token {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       TokenType
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────────────
// School Management Models
// ────────────────────────────────────────────────────────────────────────────

model Class {
  id               String       @id @default(cuid())
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name             String       // e.g. "Grade 5", "Class 9"
  section          String?      // e.g. "A", "B", "Science"
  academicYear     String?      // e.g. "2026"

  teacherId        String?
  teacher          Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  students         Student[]
  attendance       Attendance[]
  feeInvoices      FeeInvoice[]
  homeworks        Homework[]
  exams            Exam[]
  subjectAssignments ClassSubjectAssignment[]
  timetablePeriods TimetablePeriod[]
  questionPapers QuestionPaper[]

  @@unique([schoolId, name, section, academicYear])
  @@index([schoolId])
}

model Teacher {
  id               String       @id @default(cuid())
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  userId           String?      // Link to User account if they have one
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName        String
  lastName         String
  phone            String?
  email            String?
  subject          String?      // e.g. "Mathematics", "Science"

  isActive         Boolean      @default(true)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  classes          Class[]
  subjectAssignments ClassSubjectAssignment[]
  timetablePeriods TimetablePeriod[]
  questionPapers QuestionPaper[]

  @@index([schoolId])
  @@index([userId])
}

model Student {
  id               String       @id @default(cuid())
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId          String?
  class            Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)

  // Student's own user account (optional — for student portal access)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName        String
  lastName         String
  rollNo           String?
  admissionNo      String?      @unique
  dob              DateTime?
  gender           String?      // "male", "female", "other"

  parentId         String?
  parent          Parent?       @relation(fields: [parentId], references: [id], onDelete: SetNull)
  guardianVerified Boolean       @default(false)

  isActive         Boolean      @default(true)
  enrolledAt       DateTime     @default(now())

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attendance       Attendance[]
  feeInvoices      FeeInvoice[]
  homeworkSubmissions HomeworkSubmission[]
  examMarks       ExamMark[]

  @@index([schoolId])
  @@index([classId])
  @@index([parentId])
  @@index([userId])
}

model Parent {
  id               String       @id @default(cuid())
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  userId           String?      // Link to User account if they have one
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName        String
  lastName         String
  phone            String?
  email            String?
  relationship     String?      // "father", "mother", "guardian"

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  students         Student[]

  @@index([schoolId])
  @@index([userId])
}


// Daily student attendance. `date` is stored as a PostgreSQL DATE so that
// attendance identity is independent of client timezone offsets. All writes
// must validate school/class/student ownership in the application layer.
model Attendance {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  date        DateTime         @db.Date
  status      AttendanceStatus
  note        String?          @db.VarChar(500)
  markedById  String?
  markedBy    User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([schoolId, studentId, date])
  @@index([schoolId, classId, date])
  @@index([schoolId, date])
  @@index([studentId, date])
}


// Append-only snapshots of every student submission attempt/edit.
model HomeworkSubmissionHistory {
  id           String             @id @default(cuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissionId String
  submission   HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version      Int
  response     String             @db.VarChar(10000)
  submittedAt  DateTime           @default(now())
  @@unique([submissionId, version])
  @@index([schoolId, submissionId, submittedAt])
}


// ────────────────────────────────────────────────────────────────────────────
// School fee management. Monetary values use Decimal (never floating point).
// ────────────────────────────────────────────────────────────────────────────


// Homework and submissions. Text responses only: private file uploads are not enabled.
enum HomeworkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomeworkSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  REVIEWED
}

model Homework {
  id           String         @id @default(cuid())
  schoolId     String
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId      String
  schoolClass  Class          @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject      String         @db.VarChar(120)
  title        String         @db.VarChar(180)
  instructions String         @db.VarChar(10000)
  assignedAt   DateTime       @db.Timestamptz(3)
  dueAt        DateTime       @db.Timestamptz(3)
  status       HomeworkStatus @default(DRAFT)
  createdById  String
  createdBy    User           @relation("HomeworkAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  submissions  HomeworkSubmission[]
  @@index([schoolId, classId, status, dueAt])
  @@index([schoolId, createdById, createdAt])
}

model HomeworkSubmission {
  id          String                  @id @default(cuid())
  schoolId    String
  school      School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homeworkId  String
  homework    Homework                @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  response    String                  @db.VarChar(10000)
  status      HomeworkSubmissionStatus @default(SUBMITTED)
  submittedAt DateTime                @default(now())
  feedback    String?                 @db.VarChar(5000)
  reviewedAt  DateTime?
  reviewedById String?
  reviewedBy  User?                   @relation("HomeworkReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  history     HomeworkSubmissionHistory[]
  @@unique([homeworkId, studentId])
  @@index([schoolId, studentId, submittedAt])
  @@index([schoolId, homeworkId, status])
}

enum FeeFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum FeeInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WAIVED
  VOID
}

enum FeeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeeApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
}

enum FeePaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MOBILE_WALLET
  OTHER
}

model FeeCategory {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  description String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  structures FeeStructure[]
  invoices  FeeInvoice[]
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model FeeStructure {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId   String
  category     FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name         String
  frequency    FeeFrequency
  amount       Decimal      @db.Decimal(12, 2)
  academicYear String
  dueDay       Int?
  dueDate      DateTime?    @db.Date
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  invoices     FeeInvoice[]
  @@unique([schoolId, name, academicYear])
  @@index([schoolId, categoryId, academicYear])
}

model FeeInvoice {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classId        String?
  class          Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  categoryId     String
  category       FeeCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  structureId    String?
  structure      FeeStructure?   @relation(fields: [structureId], references: [id], onDelete: SetNull)
  challanNo      String          @unique
  description    String
  academicYear   String
  periodKey      String
  amount         Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  adjustmentAmount Decimal       @default(0) @db.Decimal(12, 2)
  dueDate        DateTime        @db.Date
  status         FeeInvoiceStatus @default(UNPAID)
  approvalStatus FeeApprovalStatus @default(PENDING)
  approvalComment String?
  createdById    String?
  createdBy      User? @relation("FeeInvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById   String?
  approvedBy     User? @relation("FeeInvoiceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  payments       FeePayment[]
  adjustments    FeeAdjustment[]
  approvalEvents FeeInvoiceApprovalEvent[]
  @@unique([schoolId, studentId, structureId, periodKey])
  @@index([schoolId, studentId, dueDate])
  @@index([schoolId, status, dueDate])
  @@index([schoolId, approvalStatus, createdAt])
  @@index([schoolId, categoryId])
}

model FeeInvoiceApprovalEvent {
  id        String @id @default(cuid())
  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User @relation("FeeInvoiceApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)
  action    FeeApprovalAction
  comment   String?
  createdAt DateTime @default(now())
  @@index([invoiceId, createdAt])
}

enum PaperDifficulty {
  EASY
  MEDIUM
  HARD
}

enum PaperLanguage {
  ENGLISH
  URDU
}

enum QuestionPaperStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  REJECTED
  APPROVED
}

enum QuestionPaperReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model QuestionPaper {
  id                String @id @default(cuid())
  schoolId          String
  school            School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId           String
  schoolClass       Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacherId         String
  teacher           Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdById       String
  createdBy         User @relation("QuestionPaperAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  title             String @db.VarChar(180)
  subject           String @db.VarChar(120)
  examination       String @db.VarChar(120)
  totalMarks        Decimal @db.Decimal(10, 2)
  durationMinutes   Int
  difficulty        PaperDifficulty
  language          PaperLanguage
  questions         Json
  /// Optional link to a school-authorized Punjab textbook used as primary source
  textbookId        String?
  textbook          Textbook? @relation(fields: [textbookId], references: [id], onDelete: SetNull)
  /// Selected chapter numbers / titles and page ranges (JSON array of {chapter, title?, pages?})
  selectedChapters  Json?
  /// Academic year label for the paper (e.g. 2025-26)
  academicYearLabel String? @db.VarChar(32)
  /// Instructions shown on the student paper
  instructions      String? @db.Text
  /// Answer key / marking scheme (kept separate from student-facing questions)
  answerKey         Json?
  status            QuestionPaperStatus @default(DRAFT)
  versionNumber     Int @default(0)
  approvedVersionId String? @unique
  approvedVersion   QuestionPaperVersion? @relation("ApprovedPaperVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  versions          QuestionPaperVersion[] @relation("QuestionPaperVersions")
  reviewEvents      QuestionPaperReview[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([schoolId, status, updatedAt])
  @@index([schoolId, teacherId, updatedAt])
  @@index([classId, schoolId])
  @@index([textbookId])
}

model QuestionPaperVersion {
  id             String @id @default(cuid())
  paperId        String
  paper          QuestionPaper @relation("QuestionPaperVersions", fields: [paperId], references: [id], onDelete: Cascade)
  versionNumber  Int
  snapshot       Json
  submittedById  String
  submittedBy    User @relation("PaperVersionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt    DateTime @default(now())
  approvedPaper  QuestionPaper? @relation("ApprovedPaperVersion")
  reviewEvents   QuestionPaperReview[]
  @@unique([paperId, versionNumber])
  @@index([paperId, submittedAt])
}

model QuestionPaperReview {
  id        String @id @default(cuid())
  paperId   String
  paper     QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  versionId String
  version   QuestionPaperVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User @relation("PaperReviewer", fields: [actorId], references: [id], onDelete: Restrict)
  action    QuestionPaperReviewAction
  comment   String?
  createdAt DateTime @default(now())
  @@index([paperId, createdAt])
  @@index([versionId, createdAt])
}

model FeePayment {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     FeeInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal          @db.Decimal(12, 2)
  method      FeePaymentMethod
  reference   String
  receivedAt  DateTime         @default(now())
  recordedById String
  recordedBy  User             @relation("FeePaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  note        String?
  createdAt   DateTime         @default(now())
  @@unique([schoolId, reference])
  @@index([schoolId, invoiceId, receivedAt])
}

model FeeAdjustment {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind        String   // DISCOUNT, CONCESSION, CHARGE, REFUND_NOTE
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String
  createdBy   User     @relation("FeeAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  @@index([schoolId, invoiceId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Payment & Trial Management
// ────────────────────────────────────────────────────────────────────────────

model Payment {
  id               String       @id @default(cuid())
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  amount           Float
  currency         String       @default("PKR")
  method          String        // "bank_transfer", "easy_paisa", "jazz_cash", "other"
  receiptPath     String?       // File path to uploaded receipt/screenshot

  status          PaymentStatus @default(PENDING)

  submittedBy      String?      // userId of the Principal who submitted
  submittedAt      DateTime     @default(now())

  verifiedBy       String?      // Super Admin userId
  verifiedByUser   User?        @relation(fields: [verifiedBy], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  rejectionReason  String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([schoolId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Platform Configuration & Audit
// ────────────────────────────────────────────────────────────────────────────

model PlatformSetting {
  id               String       @id @default(cuid())
  key              String       @unique
  value            String       // stored as string, parsed by app
  description      String?
  updatedAt        DateTime     @updatedAt
  updatedBy        String?
}

model AuditLog {
  id               String       @id @default(cuid())
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolId         String?
  school           School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  action           String       // e.g. "SCHOOL_APPROVED", "PAYMENT_VERIFIED", "USER_ROLE_CHANGED"
  entity           String?      // e.g. "School", "Payment", "User"
  entityId         String?
  metadata        Json?         // Additional context
  ipAddress       String?

  createdAt       DateTime     @default(now())

  @@index([userId])
  @@index([schoolId])
  @@index([action])
  @@index([createdAt])
}


// School-owned subjects and explicit class/teacher assignments used by the timetable.
model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments ClassSubjectAssignment[]
  periods     TimetablePeriod[]
  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, isActive])
}

model ClassSubjectAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  schoolClass Class  @relation(fields: [classId], references: [id], onDelete: Restrict)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([classId, subjectId])
  @@index([schoolId, classId, isActive])
  @@index([schoolId, teacherId, isActive])
}

model TimetablePeriod {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId    String
  schoolClass Class   @relation(fields: [classId], references: [id], onDelete: Restrict)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  weekday    Int      // ISO weekday: Monday=1 ... Sunday=7
  startsAt   String   // validated HH:mm local school time
  endsAt     String   // validated HH:mm local school time
  room       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([schoolId, classId, weekday, startsAt])
  @@index([schoolId, classId, weekday])
  @@index([schoolId, teacherId, weekday])
}

// Exams, marks and report cards. All records are tenant-scoped. Absence is
// explicit (isAbsent=true, marks=null) and is never silently converted to zero.
model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime?
  endsAt    DateTime?
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  terms     ExamTerm[]
  exams     Exam[]
  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model ExamTerm {
  id             String      @id @default(cuid())
  schoolId       String
  school         School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime    @default(now())
  exams          Exam[]
  @@unique([academicYearId, name])
  @@index([schoolId])
}

model Exam {
  id             String     @id @default(cuid())
  schoolId       String
  school         School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termId         String
  term           ExamTerm   @relation(fields: [termId], references: [id], onDelete: Restrict)
  classId        String
  schoolClass    Class      @relation(fields: [classId], references: [id], onDelete: Restrict)
  name           String
  type           ExamType
  examDate       DateTime
  status         ExamStatus @default(DRAFT)
  createdById    String
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  publishedById  String?
  publishedAt    DateTime?
  reviewNote     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  subjects       ExamSubject[]
  @@unique([schoolId, classId, termId, name])
  @@index([schoolId, classId, examDate])
  @@index([schoolId, status])
}

model ExamSubject {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examId         String
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject        String
  maxMarks       Decimal  @db.Decimal(8, 2)
  passingMarks   Decimal  @db.Decimal(8, 2)
  status         ExamSubjectStatus @default(DRAFT)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime @default(now())
  marks          ExamMark[]
  @@unique([examId, subject])
  @@index([schoolId, subject])
}

model ExamMark {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examSubjectId  String
  examSubject    ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks          Decimal? @db.Decimal(8, 2)
  isAbsent       Boolean  @default(false)
  note           String?
  enteredById    String
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([examSubjectId, studentId])
  @@index([schoolId, studentId])
}


model ExamGradeBand {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade          String
  minPercentage  Decimal  @db.Decimal(5, 2)
  maxPercentage  Decimal  @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([schoolId, grade])
  @@index([schoolId, minPercentage])
}


model ExamMarkHistory {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  markId            String
  examSubjectId     String
  studentId         String
  previousMarks     Decimal? @db.Decimal(8, 2)
  newMarks          Decimal? @db.Decimal(8, 2)
  previousAbsent    Boolean?
  newAbsent         Boolean
  previousNote      String?
  newNote           String?
  changedById       String
  changedAt         DateTime @default(now())
  @@index([schoolId, studentId, changedAt])
  @@index([markId, changedAt])
}


// School announcements, per-user read receipts and in-app notifications.
model Announcement {
  id            String             @id @default(cuid())
  schoolId      String
  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title         String
  message       String             @db.Text
  targetAll     Boolean            @default(true)
  audienceRoles Role[]             @default([])
  status        AnnouncementStatus @default(DRAFT)
  publishAt     DateTime?
  expiresAt     DateTime?
  archivedAt    DateTime?
  createdById   String
  createdBy     User               @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reads         AnnouncementRead[]
  notifications Notification[]

  @@index([schoolId, status, publishAt])
  @@index([schoolId, expiresAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([schoolId, userId, readAt])
}

model Notification {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  type           String
  title          String
  message        String        @db.Text
  dedupeKey      String        @unique
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([schoolId, userId, readAt, createdAt])
}

// ── Punjab Textbook Library & Question Bank (PCTB / PECTAA authorized content) ──

enum TextbookSource {
  PCTB
  PECTAA
  ELEARN_PUNJAB
  SCHOOL_UPLOAD
  OTHER_AUTHORIZED
}

enum TextbookProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  REPLACED
}

enum TextbookLanguage {
  ENGLISH
  URDU
  BOTH
}

/// School-authorized textbook (PCTB / PECTAA / school-uploaded under license).
/// Official digital corpus is not scraped; only authorized uploads or verified catalog entries are stored.
model Textbook {
  id              String                   @id @default(cuid())
  schoolId        String
  school          School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title           String                   @db.VarChar(240)
  subject         String                   @db.VarChar(120)
  classLevel      String                   @db.VarChar(40)   // Nursery, Prep, 1..12
  academicYear    String                   @db.VarChar(32)   // e.g. 2025-26
  edition         String?                  @db.VarChar(80)
  language        TextbookLanguage         @default(ENGLISH)
  source          TextbookSource           @default(SCHOOL_UPLOAD)
  publisher       String?                  @db.VarChar(160)
  isbn            String?                  @db.VarChar(32)
  /// Relative path or storage key for the authorized PDF (never redistribute without permission)
  storageKey      String?                  @db.VarChar(512)
  originalFilename String?                 @db.VarChar(255)
  fileSizeBytes   Int?
  pageCount       Int?
  processingStatus TextbookProcessingStatus @default(PENDING)
  processingError String?                  @db.Text
  /// High-level extracted summary / notes (not full copyrighted text dump)
  extractionNotes String?                  @db.Text
  uploadedById    String
  uploadedBy      User                     @relation("TextbookUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  replacedById    String?
  isActive        Boolean                  @default(true)
  chapters        TextbookChapter[]
  questionPapers  QuestionPaper[]
  questionBankItems QuestionBankItem[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([schoolId, subject, classLevel])
  @@index([schoolId, isActive, processingStatus])
  @@index([schoolId, academicYear])
}

model TextbookChapter {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  textbookId      String
  textbook        Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  chapterNumber   Int
  title           String   @db.VarChar(300)
  pageStart       Int?
  pageEnd         Int?
  /// Extracted topics / subtopics (JSON array of strings)
  topics          Json?
  /// Short extracted definitions / key concepts (JSON) — not full page text
  keyConcepts     Json?
  /// Detected exercise / question counts if extraction succeeded
  exerciseSummary Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([textbookId, chapterNumber])
  @@index([schoolId, textbookId])
}

/// Reusable questions from previous papers or teacher bank, scoped to school + chapter/topic.
model QuestionBankItem {
  id              String           @id @default(cuid())
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  textbookId      String?
  textbook        Textbook?        @relation(fields: [textbookId], references: [id], onDelete: SetNull)
  classLevel      String?          @db.VarChar(40)
  subject         String           @db.VarChar(120)
  chapterNumber   Int?
  topic           String?          @db.VarChar(240)
  questionType    String           @db.VarChar(40)  // MCQ, SHORT, LONG, ...
  difficulty      PaperDifficulty  @default(MEDIUM)
  language        PaperLanguage    @default(ENGLISH)
  prompt          String           @db.Text
  options         Json?
  answer          String?          @db.Text
  marks           Decimal          @db.Decimal(8, 2)
  sourceRef       String?          @db.VarChar(300) // e.g. "Ch. 3 p. 45"
  createdById     String
  createdBy       User             @relation("QuestionBankAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([schoolId, subject, chapterNumber])
  @@index([schoolId, textbookId])
  @@index([schoolId, questionType, difficulty])
}
